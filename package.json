{
  "name": "seekdb-monorepo-root",
  "private": true,
  "packageManager": "pnpm@9.0.5",
  "scripts": {
    "build": "pnpm --filter seekdb run build && pnpm --filter '@seekdb/*' run build",
    "build:seekdb": "pnpm --filter seekdb run build",
    "build:embeddings": "pnpm --filter '@seekdb/*' run build",
    "bindings:clean": "pnpm --filter @seekdb/js-bindings-build run clean",
    "test": "pnpm run test:server && pnpm run test:embedded && pnpm --filter @seekdb/prisma-adapter run test",
    "test:server": "pnpm --filter seekdb run test:server",
    "test:embedded": "pnpm --filter seekdb run test:embedded",
    "lint": "pnpm -r run lint",
    "type-check": "pnpm -r run type-check",
    "prettier": "prettier --write .",
    "prepare": "husky",
    "release:baseline-tags": "node scripts/baseline-tags.js",
    "release:github": "node scripts/create-github-release.js",
    "publish": "pnpm run build && lerna publish && pnpm run release:github",
    "publish:dry-run": "lerna changed -l",
    "publish:bindings-sync": "node scripts/publish-release.js",
    "publish:bindings-sync:dry-run": "node scripts/publish-release.js --dry-run"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^22.19.7",
    "dotenv": "^16.6.1",
    "husky": "^9.1.7",
    "lerna": "^8.2.4",
    "lint-staged": "^15.4.3",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": "prettier --write",
    "*.{ts,tsx,js,jsx}": "pnpm run lint"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": "git@github.com:oceanbase/seekdb-js.git"
}
